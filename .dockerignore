# Keep the build context small and free of local state.
.git
**/node_modules
**/__pycache__
**/.pytest_cache
**/.ruff_cache
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
backend/.venv
backend/var
# Data volume when it is bind-mounted inside this directory (uploads, database)
data
backend/**/tests
frontend/dist
frontend/coverage
e2e/*
!e2e/package.json
.env
