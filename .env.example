# Copy to .env next to docker-compose.yml and adjust. Never commit .env.

# Public host name; Traefik routes it to the app and gets the certificate.
PDFNUM_HOST=exams.example.org
PDFNUM_ALLOWED_HOSTS=exams.example.org

# Long random value, e.g.: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
PDFNUM_SECRET_KEY=

# HSTS: browsers will refuse plain HTTP for this host for that long. Start
# small (e.g. 3600) and raise it to a year (31536000) once HTTPS works.
PDFNUM_HSTS_SECONDS=3600

# Traefik (must match your Traefik setup)
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

# Optional limits (defaults shown)
# PDFNUM_MAX_UPLOAD_BYTES=524288000
# PDFNUM_RETENTION_SECONDS=7200
# PDFNUM_MAX_COPIES=9999
# PDFNUM_MAX_OUTPUT_PAGES=100000
# PDFNUM_UPLOAD_RATE=60/hour
# PDFNUM_CONFIG_SAVE_RATE=60/hour
# GUNICORN_WORKERS=2
# GUNICORN_THREADS=8
# PDFNUM_GENERATION_WORKERS=2
# PDFNUM_CLEANUP_INTERVAL=300
